---
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const icons = import.meta.glob<string>('../../node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const { name, size = 22, strokeWidth = 1.5, class: className = '' } = Astro.props;
const raw = icons[`../../node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown Lucide icon: ${name}`);

const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="shrink-0 ${className}"`)
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${strokeWidth}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---

<Fragment set:html={svg} />

---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import DashboardMockup from './DashboardMockup.astro';
import heroPhoto from '../assets/photos/hero-students-senior.jpg';
import { CTA_PRIMARY, CTA_PRIMARY_HREF, CTA_WHATSAPP, WHATSAPP_HREF } from '../data/site';

const leadWords = ['Turn', 'everyday', 'learning', 'into'];
---

<section aria-labelledby="hero-title" class="overflow-x-clip">
  <div class="container-page grid-page items-start gap-y-12 pt-6 pb-16 sm:pt-12 lg:pt-16 lg:pb-24">
    <div class="col-span-4 sm:col-span-8 lg:col-span-6 lg:pt-6">
      <p class="inline-flex items-center gap-3 rounded-sm bg-accent-tint px-3.5 py-2.5 text-ink">
        <Icon name="school" size={22} class="text-accent-ink" />
        <span class="text-eyebrow font-semibold uppercase">
          For principals, school owners<br />and academy directors
        </span>
      </p>

      <h1 id="hero-title" class="mt-6 text-display text-ink">
        {
          leadWords.map((w, i) => (
            <>
              <span class="hw" style={`--w:${i}`}>{w}</span>{' '}
            </>
          ))
        }
        <span class="relative inline-block whitespace-nowrap text-accent">
          <span class="hw" style={`--w:${leadWords.length}`}>visible</span>{' '}
          <span class="hw" style={`--w:${leadWords.length + 1}`}>progress.</span>
          <svg
            class="draw-load absolute -bottom-2 left-0 h-3 w-[92%] lg:-bottom-3 lg:h-4"
            style="--draw-delay:420ms"
            viewBox="0 0 300 16"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path d="M3 12 C 70 4, 170 2, 297 7" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" pathLength="1"></path>
          </svg>
        </span>
      </h1>

      <p class="mt-4 font-display text-h3 italic text-ink sm:mt-6">We build the path, you build the future.</p>

      <p class="mt-4 max-w-[46ch] text-lead text-ink-2 sm:mt-5">
        AI that checks handwritten answer sheets, sets fresh practice that never repeats, and shows you which classes
        need help this week. Built for CBSE, Tamil Nadu State Board, JEE and NEET.
      </p>

      <div class="mt-6 flex flex-col gap-2.5 sm:mt-8 sm:flex-row sm:flex-wrap sm:gap-3" data-hero-cta>
        <Button href={CTA_PRIMARY_HREF} block>{CTA_PRIMARY}</Button>
        <Button href={WHATSAPP_HREF} variant="secondary" icon="message-circle" block>{CTA_WHATSAPP}</Button>
      </div>

      <p class="mt-5 flex flex-col gap-1 text-small text-ink-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3">
        <span><strong class="font-semibold text-ink">10,000+ students</strong> already learning on Study Buddy</span>
        <span aria-hidden="true" class="hidden text-line-strong sm:inline">·</span>
        <span>Live in your institute within 48 hours</span>
      </p>
    </div>

    <div class="relative col-span-4 sm:col-span-8 lg:col-span-6 lg:pt-6">
      <div class="overflow-hidden rounded-lg bg-paper-2">
        <Picture
          src={heroPhoto}
          formats={['avif', 'webp']}
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 588px, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2rem)"
          alt="Senior-secondary students in school uniform listening closely in a classroom."
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover object-[30%_45%] sm:aspect-[16/10] sm:object-[40%_45%]"
        />
      </div>

      <div
        class="relative -mt-8 mx-3 sm:mx-auto sm:-mt-24 sm:w-[78%] lg:-mt-28 lg:ml-[-15%] lg:mr-0 lg:w-[82%]"
        data-tilt
      >
        <DashboardMockup />
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hw {
      display: inline-block;
      animation: hw-in 450ms var(--ease-out) both;
      animation-delay: calc(var(--w) * 55ms);
    }
  }
  @keyframes hw-in {
    from {
      opacity: 0.35;
      transform: translateY(0.18em);
    }
  }
</style>

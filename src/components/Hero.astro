---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import DashboardMockup from './DashboardMockup.astro';
import heroPhoto from '../assets/photos/hero-students-classroom.jpg';
import { CTA_PRIMARY, CTA_PRIMARY_HREF, CTA_WHATSAPP, WHATSAPP_HREF } from '../data/site';
---

<section aria-labelledby="hero-title" class="overflow-x-clip">
  <div class="container-page grid-page items-start gap-y-12 pt-8 pb-16 sm:pt-12 lg:pt-16 lg:pb-24">
    <div class="col-span-4 sm:col-span-8 lg:col-span-6 lg:pt-6">
      <p class="inline-flex items-center gap-3 rounded-sm bg-accent-tint px-3.5 py-2.5 text-ink">
        <Icon name="school" size={22} class="text-accent-ink" />
        <span class="text-eyebrow font-semibold uppercase">
          For principals, school owners<br />and academy directors
        </span>
      </p>

      <h1 id="hero-title" class="mt-6 text-display text-ink">
        Turn everyday learning into
        <span class="relative inline-block whitespace-nowrap text-accent">
          visible progress.
          <svg
            class="hero-underline absolute -bottom-2 left-0 h-3 w-[92%] lg:-bottom-3 lg:h-4"
            viewBox="0 0 300 16"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path d="M3 12 C 70 4, 170 2, 297 7" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" pathLength="1"></path>
          </svg>
        </span>
      </h1>

      <p class="mt-6 font-display text-h3 italic text-ink">We build the path, you build the future.</p>

      <p class="mt-5 max-w-[52ch] text-lead text-ink-2">
        Study Buddy gives your institute one AI platform for practice, doubt-solving, answer-sheet evaluation and
        progress reports. Your teachers spend less time correcting, and you see where results need support, while there
        is still time to act.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-hero-cta>
        <Button href={CTA_PRIMARY_HREF} block>{CTA_PRIMARY}</Button>
        <Button href={WHATSAPP_HREF} variant="secondary" icon="message-circle" block>{CTA_WHATSAPP}</Button>
      </div>

      <ul class="mt-6 flex flex-col gap-2 text-small text-ink-2 sm:flex-row sm:gap-6">
        <li class="flex items-center gap-2">
          <Icon name="check" size={18} class="text-teal" />
          Trusted by 10,000+ students
        </li>
        <li class="flex items-center gap-2">
          <Icon name="check" size={18} class="text-teal" />
          Live in your institute within 48 hours
        </li>
      </ul>
    </div>

    <div class="relative col-span-4 sm:col-span-8 lg:col-span-6">
      <div aria-hidden="true" class="mb-2 flex items-end justify-end gap-1 pr-2 text-accent-ink sm:pr-6">
        <span class="-rotate-[4deg] font-note text-note">From classroom to confidence</span>
        <svg class="mb-[-14px] h-9 w-8 shrink-0" viewBox="0 0 32 36" fill="none">
          <path d="M6 4 C 20 8, 26 18, 22 31" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path d="M16 26 L 22 32 L 27 25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>

      <div class="overflow-hidden rounded-lg bg-paper-2">
        <Picture
          src={heroPhoto}
          formats={['avif', 'webp']}
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 588px, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2rem)"
          alt="Two students in school uniform at their classroom desk, one reading her textbook and one writing notes."
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover object-[68%_40%] sm:aspect-[16/10] sm:object-center"
        />
      </div>

      <DashboardMockup
        class="relative -mt-8 mx-3 sm:mx-auto sm:-mt-24 sm:w-[78%] lg:-mt-28 lg:ml-[-15%] lg:mr-0 lg:w-[82%]"
      />
    </div>
  </div>
</section>

<style>
  :global(.motion-ok) .hero-underline path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw var(--dur-slow) var(--ease-out) 200ms forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import DashboardMockup from './DashboardMockup.astro';
import heroPhoto from '../assets/photos/hero-students-classroom.jpg';
import { CTA_PRIMARY, CTA_PRIMARY_HREF, CTA_WHATSAPP, WHATSAPP_HREF } from '../data/site';

const leadWords = ['Turn', 'everyday', 'learning', 'into'];
---

<section aria-labelledby="hero-title" class="overflow-x-clip">
  <div class="container-page grid-page items-start gap-y-12 pt-6 pb-16 sm:pt-12 lg:pt-16 lg:pb-24">
    <div class="col-span-4 sm:col-span-8 lg:col-span-6 lg:pt-6">
      <p class="inline-flex items-center gap-3 rounded-sm bg-accent-tint px-3.5 py-2.5 text-ink">
        <Icon name="school" size={22} class="text-accent-ink" />
        <span class="text-eyebrow font-semibold uppercase">
          For principals, school owners<br />and academy directors
        </span>
      </p>

      <h1 id="hero-title" class="mt-6 text-display text-ink">
        {
          leadWords.map((w, i) => (
            <>
              <span class="hw" style={`--w:${i}`}>{w}</span>{' '}
            </>
          ))
        }
        <span class="relative inline-block whitespace-nowrap">
          <span class="hw hero-grad" style={`--w:${leadWords.length};--g-from:#2563eb;--g-to:#4f46e5`}>visible</span>{' '}
          <span class="hw hero-grad" style={`--w:${leadWords.length + 1};--g-from:#4f46e5;--g-to:#7c3aed`}>progress.</span>
          <svg
            class="draw-load absolute -bottom-2 left-0 h-3 w-[92%] lg:-bottom-3 lg:h-4"
            style="--draw-delay:420ms"
            viewBox="0 0 300 16"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <defs>
              <linearGradient id="hero-underline-grad" x1="0" y1="0" x2="300" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#2563eb" />
                <stop offset="1" stop-color="#7c3aed" />
              </linearGradient>
            </defs>
            <path d="M3 12 C 70 4, 170 2, 297 7" stroke="url(#hero-underline-grad)" stroke-width="3.5" stroke-linecap="round" pathLength="1"></path>
          </svg>
        </span>
      </h1>

      <p class="mt-4 font-display text-h3 italic text-ink sm:mt-6">We build the path, you build the future.</p>

      <p class="mt-4 max-w-[52ch] text-lead text-ink-2 sm:mt-5">
        Study Buddy gives your institute one AI platform for practice, doubt-solving, answer-sheet evaluation and
        progress reports. Your teachers spend less time correcting, and you see where results need support, while there
        is still time to act.
      </p>

      <div class="mt-6 flex flex-col gap-2.5 sm:mt-8 sm:flex-row sm:flex-wrap sm:gap-3" data-hero-cta>
        <Button href={CTA_PRIMARY_HREF} block>{CTA_PRIMARY}</Button>
        <Button href={WHATSAPP_HREF} variant="secondary" icon="message-circle" block>{CTA_WHATSAPP}</Button>
      </div>

      <ul class="mt-6 flex flex-col gap-2 text-small text-ink-2 sm:flex-row sm:gap-6">
        <li class="flex items-center gap-2">
          <Icon name="check" size={18} class="text-teal" />
          Trusted by 10,000+ students
        </li>
        <li class="flex items-center gap-2">
          <Icon name="check" size={18} class="text-teal" />
          Live in your institute within 48 hours
        </li>
      </ul>
    </div>

    <div class="relative col-span-4 sm:col-span-8 lg:col-span-6">
      <div aria-hidden="true" class="mb-2 flex items-end justify-end gap-1 pr-2 text-accent-ink sm:pr-6">
        <span class="-rotate-[4deg] font-note text-note">From classroom to confidence</span>
        <svg class="draw-load mb-[-14px] h-9 w-8 shrink-0" style="--draw-delay:700ms" viewBox="0 0 32 36" fill="none">
          <path d="M6 4 C 20 8, 26 18, 22 31" stroke="currentColor" stroke-width="2" stroke-linecap="round" pathLength="1"></path>
          <path d="M16 26 L 22 32 L 27 25" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" pathLength="1" style="--draw-delay:1000ms;--draw-dur:200ms"></path>
        </svg>
      </div>

      <div class="overflow-hidden rounded-lg bg-paper-2" data-parallax>
        <Picture
          src={heroPhoto}
          formats={['avif', 'webp']}
          widths={[480, 768, 1200]}
          sizes="(min-width: 1024px) 588px, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2rem)"
          alt="Two students in school uniform at their classroom desk, one reading her textbook and one writing notes."
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full object-cover object-[68%_40%] sm:aspect-[16/10] sm:object-center"
        />
      </div>

      <div
        class="relative -mt-8 mx-3 sm:mx-auto sm:-mt-24 sm:w-[78%] lg:-mt-28 lg:ml-[-15%] lg:mr-0 lg:w-[82%]"
        data-tilt
      >
        <DashboardMockup />
      </div>
    </div>
  </div>
</section>

<style>
  /* Each word gets its own slice of the blue→violet ramp so the gradient reads continuously
     across the two separately-animated word spans. Padding keeps descenders inside the clip. */
  .hero-grad {
    display: inline-block;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
    background-image: linear-gradient(90deg, var(--g-from), var(--g-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hw {
      display: inline-block;
      animation: hw-in 450ms var(--ease-out) both;
      animation-delay: calc(var(--w) * 55ms);
    }
  }
  @keyframes hw-in {
    from {
      opacity: 0.35;
      transform: translateY(0.18em);
    }
  }
</style>

---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { CTA_PRIMARY, CTA_PRIMARY_HREF, CTA_WHATSAPP, WHATSAPP_HREF } from '../data/site';
---

<div
  class="sticky-cta fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface px-3 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-2 sm:hidden"
  data-sticky-cta
  data-visible="false"
>
  <div class="flex gap-2">
    <Button href={CTA_PRIMARY_HREF} class="flex-1 px-4">{CTA_PRIMARY}</Button>
    <a
      href={WHATSAPP_HREF}
      target="_blank"
      rel="noopener"
      aria-label={`${CTA_WHATSAPP} (opens in a new tab)`}
      class="grid size-12 shrink-0 place-items-center rounded-sm border-[1.5px] border-ink text-ink"
    >
      <Icon name="message-circle" size={22} />
    </a>
  </div>
</div>

<style>
  .sticky-cta {
    transform: translateY(100%);
    visibility: hidden;
    transition:
      transform var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }
  .sticky-cta[data-visible='true'] {
    transform: none;
    visibility: visible;
    transition:
      transform var(--dur-base) var(--ease-out),
      visibility 0s;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const hero = document.querySelector('[data-hero-cta]');
  const stops = document.querySelectorAll('[data-hide-sticky]');
  if (bar && hero && 'IntersectionObserver' in window) {
    let heroVisible = true;
    let stopVisible = false;
    const update = () => {
      const show = !heroVisible && !stopVisible;
      bar.dataset.visible = String(show);
      document.body.style.paddingBottom = show && window.innerWidth < 640 ? `${bar.offsetHeight}px` : '';
    };
    new IntersectionObserver(([e]) => {
      heroVisible = e.isIntersecting;
      update();
    }).observe(hero);
    if (stops.length) {
      new IntersectionObserver((entries) => {
        stopVisible = entries.some((e) => e.isIntersecting);
        update();
      }).observe(stops[0]);
    }
  }
</script>

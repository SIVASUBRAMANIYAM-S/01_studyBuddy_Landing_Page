---
import Icon from '../Icon.astro';

const handwritten = [
  { text: '2x = 17 + 5', wrong: true },
  { text: '2x = 22', wrong: false },
  { text: 'x = 11', wrong: true },
];

const feedback = [
  {
    ok: true,
    line: 'Method: isolate x first',
    note: 'Correct approach.',
  },
  {
    ok: false,
    line: '2x = 17 + 5',
    note: 'Subtract 5 from both sides, don’t add it: 2x = 17 − 5 = 12.',
  },
  {
    ok: false,
    line: 'x = 11',
    note: 'Carry the fix through: x = 12 ÷ 2 = 6.',
  },
];
---

<figure class="answer relative" data-reveal>
  <figcaption class="sr-only">
    Illustrative example. A handwritten answer to “Solve 2x + 5 = 17” is scanned and graded. The two mistaken steps
    are highlighted with step-wise feedback, and the result is added to class, student and parent reports.
  </figcaption>

  <div aria-hidden="true" class="grid items-center gap-4 lg:grid-cols-[minmax(0,0.9fr)_auto_minmax(0,1.1fr)] lg:gap-5">
    <div class="paper relative mx-2 -rotate-[1.5deg] rounded-[3px] border border-line bg-surface px-5 pt-4 pb-6 shadow-2 sm:mx-10 lg:mx-0">
      <div class="flex items-baseline justify-between gap-2 border-b border-line pb-2 text-[0.6875rem] text-ink-2">
        <span>Unit test · Mathematics</span>
        <span>Class 8 B</span>
      </div>
      <p class="mt-3 pl-7 text-[0.8125rem] font-semibold text-ink">Q3. Solve: 2x + 5 = 17</p>
      <ol class="mt-1 pl-7">
        {
          handwritten.map((l) => (
            <li class="relative font-note text-[1.6rem] leading-[2.25rem] text-ink">
              <span class="relative inline-block">
                {l.wrong && <span class="absolute inset-x-[-4px] inset-y-1 origin-left rounded-[2px] bg-accent-tint" data-sweep />}
                <span class="relative">{l.text}</span>
              </span>
              {l.wrong && (
                <span class="absolute top-1/2 -left-6 -translate-y-1/2 text-accent" data-mark>
                  <Icon name="x" size={16} strokeWidth={2.5} />
                </span>
              )}
            </li>
          ))
        }
      </ol>
      <span class="absolute top-0 bottom-0 left-8 w-px bg-accent/35"></span>
    </div>

    <div class="flex items-center justify-center gap-2 text-teal-ink lg:flex-col">
      <span class="grid size-11 place-items-center rounded-full border border-line bg-surface shadow-1">
        <Icon name="scan-line" size={20} />
      </span>
      <span class="text-[0.75rem] font-semibold">Graded in seconds</span>
      <Icon name="arrow-down" size={18} class="lg:-rotate-90" />
    </div>

    <div class="overflow-hidden rounded-md border border-line bg-surface shadow-2" data-feedback>
      <div class="flex items-center justify-between gap-3 border-b border-line bg-paper-2 px-4 py-3">
        <div>
          <p class="text-[0.875rem] font-semibold leading-tight text-ink">Q3 · Linear equations</p>
          <p class="mt-0.5 text-[0.6875rem] text-ink-2">Illustrative example</p>
        </div>
        <span class="rounded-sm border border-line bg-surface px-2.5 py-1 text-[0.8125rem] font-semibold tabular-nums text-ink" data-score>
          1 / 3
        </span>
      </div>

      <ol class="divide-y divide-line">
        {
          feedback.map((f) => (
            <li class:list={['flex gap-3 px-4 py-3', !f.ok && 'bg-accent-tint/60']} data-row={f.ok ? 'ok' : 'mistake'}>
              <span class:list={['mt-0.5', f.ok ? 'text-success' : 'text-accent-ink']}>
                <Icon name={f.ok ? 'circle-check' : 'circle-x'} size={18} />
              </span>
              <div class="min-w-0">
                <p class:list={['text-[0.8125rem] font-semibold', f.ok ? 'text-ink' : 'text-accent-ink']}>{f.line}</p>
                <p class="mt-0.5 text-[0.8125rem] leading-snug text-ink-2">{f.note}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-line px-4 py-3 text-[0.6875rem] text-ink-2">
        <Icon name="file-check" size={14} class="text-teal" />
        <span>Added to</span>
        <span class="font-semibold text-ink">Class report</span>
        <span class="text-line-strong">·</span>
        <span class="font-semibold text-ink">Student report</span>
        <span class="text-line-strong">·</span>
        <span class="font-semibold text-ink">Parent report</span>
      </div>
    </div>
  </div>
</figure>

<style>
  .paper {
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(2.25rem - 1px),
      color-mix(in srgb, var(--color-teal) 14%, transparent) calc(2.25rem - 1px),
      color-mix(in srgb, var(--color-teal) 14%, transparent) 2.25rem
    );
    background-position: 0 4.35rem;
  }
</style>

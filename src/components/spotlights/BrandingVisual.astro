---
import Icon from '../Icon.astro';

const school = '#7A2935';
const swatches = [
  { color: school, label: 'Maroon', on: true },
  { color: '#1E3A5F', label: 'Navy', on: false },
  { color: '#2F5D3A', label: 'Forest', on: false },
];
const nav = [
  { icon: 'layout-dashboard', label: 'Dashboard', on: true },
  { icon: 'book-open', label: 'NCERT chapters' },
  { icon: 'clipboard-list', label: 'Practice exams' },
  { icon: 'chart-line', label: 'Analytics' },
  { icon: 'users-round', label: 'Parent portal' },
];
---

<figure class="brand relative" data-reveal style={`--school:${school}`}>
  <figcaption class="sr-only">
    Illustrative example of a student dashboard carrying a placeholder school's name, crest and maroon brand colour,
    with a small Powered by Vivodha mark in the sidebar.
  </figcaption>

  <div aria-hidden="true">
    <div class="mb-3 flex items-center gap-3 text-[0.75rem] text-ink-2">
      <Icon name="palette" size={16} />
      <span>Your brand colour</span>
      <span class="flex gap-1.5">
        {
          swatches.map((s) => (
            <span
              class:list={['size-5 rounded-full', s.on && 'ring-2 ring-ink ring-offset-2 ring-offset-paper-2']}
              style={`background:${s.color}`}
            />
          ))
        }
      </span>
    </div>

    <div class="flex overflow-hidden rounded-lg border border-line bg-surface shadow-2">
      <aside class="flex w-[38%] shrink-0 flex-col bg-(--school) p-3 text-white sm:w-[34%] sm:p-4">
        <div class="flex items-center gap-2">
          <span class="grid size-8 shrink-0 place-items-center rounded-sm bg-white text-(--school)">
            <Icon name="shield" size={18} strokeWidth={2} />
          </span>
          <span class="min-w-0 leading-tight">
            <span class="block text-[0.75rem] font-semibold sm:text-[0.8125rem]">Your School Name</span>
            <span class="block text-[0.625rem] text-white/75">Learning portal</span>
          </span>
        </div>
        <ul class="mt-5 space-y-1">
          {
            nav.map((n, i) => (
              <li
                class:list={[
                  'flex items-center gap-2 rounded-sm px-2 py-1.5 text-[0.6875rem] sm:text-[0.75rem]',
                  n.on ? 'bg-white/15 font-semibold' : 'text-white/80',
                  i > 2 && 'hidden sm:flex',
                ]}
              >
                <Icon name={n.icon} size={14} />
                <span class="truncate">{n.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-auto pt-6 text-[0.5625rem] tracking-[0.04em] text-white/55">Powered by Vivodha</p>
      </aside>

      <div class="min-w-0 flex-1 bg-paper p-3 sm:p-5">
        <p class="text-[0.6875rem] text-ink-2">Class 9 A</p>
        <p class="mt-0.5 font-display text-[1rem] font-semibold text-ink sm:text-[1.125rem]">Welcome back, Priya</p>

        <div class="mt-4 rounded-sm border border-line bg-surface p-3">
          <p class="text-[0.6875rem] text-ink-2">Today's practice</p>
          <p class="mt-0.5 text-[0.75rem] font-semibold text-ink sm:text-[0.8125rem]">Science · Chapter 4</p>
          <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-paper-2">
            <div class="h-full w-[60%] rounded-full bg-(--school)"></div>
          </div>
        </div>

        <div class="mt-2.5 rounded-sm border border-line bg-surface p-3">
          <p class="text-[0.6875rem] text-ink-2">Next test</p>
          <p class="mt-0.5 text-[0.75rem] font-semibold text-ink sm:text-[0.8125rem]">Maths unit test · Friday</p>
        </div>

        <span class="mt-3 inline-flex items-center gap-1.5 rounded-sm bg-(--school) px-2.5 py-1.5 text-[0.6875rem] font-semibold text-white">
          Ask a doubt
        </span>
      </div>
    </div>

    <p class="mt-3 text-[0.75rem] text-ink-2">Placeholder school branding, for illustration.</p>
  </div>
</figure>

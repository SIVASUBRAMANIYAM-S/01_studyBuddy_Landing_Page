---
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

const gains = [
  {
    title: 'Higher average marks and pass percentage',
    body: 'Personal practice lifts average and below-average students, and early intervention catches weak topics before the exam.',
  },
  {
    title: 'Lighter teacher workload',
    body: 'AI answer-sheet evaluation, ready tests and a round-the-clock AI tutor give teachers time back for teaching.',
  },
  {
    title: 'Stronger parent trust',
    body: 'Parents see progress, strengths and gaps throughout the year, not just at report-card time.',
  },
  {
    title: 'A reputation that drives admissions',
    body: 'Better results, happier parents and a modern platform under your own brand become the reason families choose you.',
  },
];

const protections = [
  {
    icon: 'map-pin',
    title: 'Hosted in India.',
    body: 'Enterprise-grade cloud infrastructure, with all student and institute data stored on Indian servers.',
  },
  {
    icon: 'lock-keyhole',
    title: 'Encrypted end to end.',
    body: 'AES-256 encryption for stored data and TLS 1.2+ for data in transit.',
  },
  {
    icon: 'shield-check',
    title: 'Built for the DPDP Act.',
    body: 'Role-based access, parent consent management, and data export or deletion on request.',
  },
  { icon: 'key-round', title: 'Your institute owns its data.', body: 'We never sell or share it.' },
];
---

<section id="outcomes" aria-labelledby="outcomes-title" class="section-y">
  <div class="container-page grid-page gap-y-10">
    <div class="col-span-4 sm:col-span-8 lg:col-span-4">
      <div class="lg:sticky lg:top-28" data-reveal>
        <Eyebrow>The outcome</Eyebrow>
        <h2 id="outcomes-title" class="mt-4 text-h2 lg:mt-5">What your institute gains.</h2>
        <p class="measure mt-5 text-ink-2">
          Results parents notice, workload your teachers feel, and a reputation that brings in admissions.
        </p>
      </div>
    </div>

    <ol class="col-span-4 grid sm:col-span-8 sm:grid-cols-2 sm:gap-x-10 lg:col-span-7 lg:col-start-6">
      {
        gains.map((g, i) => (
          <li class="border-t border-line py-7" data-reveal style={`--reveal-i:${i % 2}`}>
            <span class="font-display text-[1rem] font-semibold tabular-nums text-accent-ink">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-h3 font-semibold">{g.title}</h3>
            <p class="mt-2 text-ink-2">{g.body}</p>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="container-page mt-12 lg:mt-20">
    <div class="grid-page gap-y-8 rounded-lg bg-teal-tint p-6 sm:p-10 lg:p-12" data-reveal>
      <div class="col-span-4 sm:col-span-8 lg:col-span-4">
        <span class="grid size-12 place-items-center rounded-sm bg-surface text-teal-ink shadow-1">
          <Icon name="shield-check" size={26} />
        </span>
        <h3 class="mt-5 text-h3 font-semibold">Student data stays in India, and stays yours.</h3>
      </div>
      <ul class="col-span-4 grid gap-6 sm:col-span-8 sm:grid-cols-2 lg:col-span-8 lg:gap-x-10">
        {
          protections.map((p) => (
            <li class="flex gap-3">
              <Icon name={p.icon} size={20} class="mt-[3px] text-teal-ink" />
              <p>
                <strong class="font-semibold text-ink">{p.title}</strong> <span class="text-ink-2">{p.body}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

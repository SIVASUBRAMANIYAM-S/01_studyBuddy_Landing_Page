---
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
import { CTA_WHATSAPP, WHATSAPP_HREF } from '../data/site';
import { faqs } from '../data/faq';
---

<section id="faq" aria-labelledby="faq-title" class="section-y border-t border-line">
  <div class="container-page grid-page gap-y-10">
    <div class="col-span-4 sm:col-span-8 lg:col-span-4">
      <div class="lg:sticky lg:top-28" data-reveal>
        <Eyebrow>Questions</Eyebrow>
        <h2 id="faq-title" class="mt-4 text-h2 lg:mt-5">What school leaders usually ask us.</h2>
        <p class="mt-6 hidden text-ink-2 lg:block">
          Still have a question?{" "}
          <a href={WHATSAPP_HREF} target="_blank" rel="noopener" class="font-semibold text-accent-ink underline decoration-1 underline-offset-[3px] hover:decoration-2">
            {CTA_WHATSAPP}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </div>

    <div class="col-span-4 sm:col-span-8 lg:col-span-7 lg:col-start-6">
      <div class="border-t border-line">
        {
          faqs.map((f) => (
            <details class="faq group border-b border-line">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-[1.125rem] font-semibold text-ink [&::-webkit-details-marker]:hidden">
                <span>{f.q}</span>
                <span class="grid size-8 shrink-0 place-items-center rounded-full text-teal-ink transition-transform duration-200 ease-(--ease-out) group-open:rotate-45">
                  <Icon name="plus" size={22} />
                </span>
              </summary>
              <p class="max-w-[65ch] pr-10 pb-6 text-ink-2">{f.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-8 text-ink-2 lg:hidden">
        Still have a question?{" "}
        <a href={WHATSAPP_HREF} target="_blank" rel="noopener" class="font-semibold text-accent-ink underline decoration-1 underline-offset-[3px]">
          {CTA_WHATSAPP}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .faq::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      block-size var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      content-visibility var(--dur-base) allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  .faq summary:hover > span:first-child {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>

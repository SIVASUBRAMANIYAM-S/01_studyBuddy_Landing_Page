---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const columns = [
  { label: 'Participation', value: 'By class' },
  { label: 'Topic progress', value: 'By subject' },
  { label: 'Mock-test trends', value: 'Over time' },
];

const bars = [
  { label: 'Practice completed', meta: 'Weekly view', width: '78%', color: 'bg-accent' },
  { label: 'Topics needing support', meta: 'By subject', width: '46%', color: 'bg-teal' },
  { label: 'Mock-test readiness', meta: 'Trend over time', width: '64%', color: 'bg-ochre' },
];
---

<figure
  class:list={['dash overflow-hidden rounded-lg border border-line bg-surface text-ink shadow-2', className]}
  data-reveal
>
  <figcaption class="sr-only">
    Illustrative preview of the Study Buddy academic overview. It shows participation by class, topic progress by
    subject and mock-test trends over time. Example indicators only, not real school results.
  </figcaption>

  <div aria-hidden="true" class="flex h-7 items-center gap-1.5 border-b border-line bg-paper-2 px-3">
    <span class="size-2 rounded-full bg-line-strong/60"></span>
    <span class="size-2 rounded-full bg-line-strong/60"></span>
    <span class="size-2 rounded-full bg-line-strong/60"></span>
  </div>

  <div aria-hidden="true" class="p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[0.9375rem] font-semibold leading-tight">Academic overview</p>
        <p class="mt-1 text-[0.75rem] text-ink-2">Illustrative preview</p>
      </div>
      <span class="inline-flex items-center gap-1.5 rounded-sm border border-line px-2 py-1 text-[0.75rem] text-ink-2">
        <Icon name="calendar" size={14} />
        Weekly view
      </span>
    </div>

    <div class="mt-4 grid grid-cols-3 divide-x divide-line rounded-sm border border-line">
      {
        columns.map((c) => (
          <div class="px-2.5 py-2.5 sm:px-3">
            <p class="text-[0.6875rem] leading-tight text-ink-2 sm:text-[0.75rem]">{c.label}</p>
            <p class="mt-1 text-[0.8125rem] font-semibold leading-tight">{c.value}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex items-start justify-between gap-3">
      <div>
        <p class="text-[0.875rem] font-semibold leading-tight">Signals for the next check-in</p>
        <p class="mt-1 text-[0.75rem] text-ink-2">Example indicators, not school results</p>
      </div>
      <span class="text-accent"><Icon name="target" size={18} /></span>
    </div>

    <ul class="mt-4 space-y-3.5">
      {
        bars.map((b, i) => (
          <li>
            <div class="flex items-baseline justify-between gap-3 text-[0.8125rem]">
              <span class="font-semibold">{b.label}</span>
              <span class="text-[0.6875rem] text-ink-2">{b.meta}</span>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-paper-2">
              <div class:list={['dash-bar h-full rounded-full', b.color]} style={`width:${b.width};--bar-i:${i}`} />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex items-start gap-2.5 rounded-sm bg-teal-tint px-3 py-2.5 text-[0.75rem] leading-snug text-teal-ink">
      <Icon name="message-circle" size={16} class="mt-px" />
      <p>Use learning signals to plan teacher follow-up, revision and the next practice cycle.</p>
    </div>

    <div class="mt-4 flex items-center justify-between gap-3 border-t border-line pt-3 text-[0.6875rem] text-ink-2">
      <span class="flex items-center gap-1.5">
        <span class="size-1.5 rounded-full bg-success"></span>
        Management · Teacher · Parent · Student views
      </span>
      <span class="hidden sm:inline">Illustration only</span>
    </div>
  </div>
</figure>

<style>
  .dash-bar {
    transform-origin: left center;
  }
  :global(.motion-ok) .dash .dash-bar {
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-out);
    transition-delay: calc(200ms + var(--bar-i) * 80ms);
  }
  :global(.motion-ok) .dash:global(.is-visible) .dash-bar {
    transform: scaleX(1);
  }
</style>

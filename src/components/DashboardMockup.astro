---
import Icon from './Icon.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const bars = [
  { label: 'Practice completed', meta: '10 A – 10 D', width: '78%', color: 'bg-teal' },
  { label: 'Electricity · Physics', meta: 'Needs revision', width: '46%', color: 'bg-ochre' },
  { label: 'Board mock readiness', meta: 'Rising', width: '64%', color: 'bg-teal' },
];
---

<figure
  class:list={['dash overflow-hidden rounded-lg border border-line bg-surface text-ink shadow-2', className]}
  data-reveal
>
  <figcaption class="sr-only">
    Illustrative example of the Study Buddy weekly overview for Class 10: practice completion, a physics topic that
    needs revision, board mock readiness, and an alert that section 10 C has gone quiet this week.
  </figcaption>

  <div aria-hidden="true" class="p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[0.9375rem] font-semibold leading-tight">This week · Class 10</p>
      <span class="rounded-sm bg-paper-2 px-2 py-1 text-[0.6875rem] font-semibold uppercase tracking-[0.08em] text-ink-2">
        Illustrative
      </span>
    </div>

    <ul class="mt-4 space-y-3.5">
      {
        bars.map((b, i) => (
          <li>
            <div class="flex items-baseline justify-between gap-3 text-[0.8125rem]">
              <span class="font-semibold">{b.label}</span>
              <span class="text-[0.75rem] text-ink-2">{b.meta}</span>
            </div>
            <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-paper-2">
              <div class:list={['dash-bar h-full rounded-full', b.color]} style={`width:${b.width};--bar-i:${i}`} />
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 flex items-start gap-2.5 rounded-sm bg-accent-tint px-3 py-2.5 text-[0.8125rem] leading-snug text-ink">
      <Icon name="bell" size={16} class="mt-0.5 text-accent-ink" />
      <p><strong class="font-semibold">10 C has gone quiet this week.</strong> Suggested: a teacher follow-up.</p>
    </div>
  </div>
</figure>

<style>
  .dash-bar {
    transform-origin: left center;
  }
  :global(.motion-ok) .dash .dash-bar {
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-out);
    transition-delay: calc(200ms + var(--bar-i) * 80ms);
  }
  :global(.motion-ok) .dash:global(.is-visible) .dash-bar {
    transform: scaleX(1);
  }
</style>

---
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';

const steps = [
  { n: '01', icon: 'book-open', title: 'Read', body: 'Chapter-wise NCERT reading, a formula hub and flashcards for quick revision.' },
  { n: '02', icon: 'message-circle', title: 'Ask', body: 'AI answers to doubts in under 30 seconds, plus group study rooms.' },
  { n: '03', icon: 'clipboard-check', title: 'Practise', body: 'Chapter tests, school tests and JEE, NEET and board-pattern mocks.' },
  {
    n: '04',
    icon: 'chart-line',
    title: 'Track',
    body: 'Exam readiness score, AI score predictions and a marks tracker, visible to teachers and parents.',
  },
];
---

<section id="journey" aria-labelledby="journey-title" class="section-y">
  <div class="container-page">
    <div class="max-w-[46rem]" data-reveal>
      <Eyebrow>How students learn</Eyebrow>
      <h2 id="journey-title" class="mt-4 text-h2 lg:mt-5">From NCERT chapter to exam-ready, in four steps.</h2>
      <p class="measure mt-4 text-ink-2 lg:mt-5">
        A simple daily routine your teachers can guide and your management can measure.
      </p>
    </div>

    <ol class="mt-10 grid sm:grid-cols-2 sm:gap-x-8 lg:mt-14 lg:grid-cols-4 lg:gap-x-0">
      {
        steps.map((s, i) => (
          <li
            class="relative border-l border-line pb-8 pl-6 last:pb-0 sm:border-l-0 sm:border-t sm:pt-6 sm:pl-0 lg:border-t-0 lg:border-l lg:px-7 lg:pt-0 lg:pb-0 lg:first:border-l-0 lg:first:pl-0"
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <span aria-hidden="true" class="absolute top-1 -left-[5px] size-2.5 rounded-full bg-accent sm:hidden" />
            <div class="flex items-center justify-between gap-4">
              <span class="text-small font-semibold tabular-nums text-accent-ink">{s.n}</span>
              <span class="text-teal">
                <Icon name={s.icon} size={24} />
              </span>
            </div>
            <h3 class="mt-3 text-h3 font-semibold">{s.title}</h3>
            <p class="mt-2 text-ink-2">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

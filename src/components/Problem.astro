---
import Eyebrow from './Eyebrow.astro';

const pains = [
  {
    title: 'Teachers lose evenings to correction.',
    body: 'Checking stacks of handwritten answer sheets takes time that should go into teaching and student follow-up.',
  },
  {
    title: 'Practice papers start repeating.',
    body: 'Students memorise the same questions instead of learning the concept, so practice scores stop meaning anything.',
  },
  {
    title: 'Weak areas show up too late.',
    body: 'By the time unit-test marks are compiled, the chapter is finished and the class has moved on.',
  },
  {
    title: "Parents ask, and there's no clear answer.",
    body: '“How is my child really doing?” deserves more than a mark sheet at the end of term.',
  },
];
---

<section id="problem" aria-labelledby="problem-title" class="section-y">
  <div class="container-page grid-page gap-y-10">
    <div class="col-span-4 sm:col-span-8 lg:col-span-5">
      <div class="lg:sticky lg:top-28" data-reveal>
        <Eyebrow>The problem</Eyebrow>
        <h2 id="problem-title" class="mt-4 text-h2 lg:mt-5">Results are decided long before exam week.</h2>
        <p class="measure mt-4 text-ink-2 lg:mt-5">
          Pass percentages and entrance-exam selections are what parents judge your institute on. They are built over
          months of steady practice and timely support. Most of that work is still invisible until the marks arrive.
        </p>
      </div>
    </div>

    <ol class="col-span-4 grid gap-0 sm:col-span-8 sm:grid-cols-2 sm:gap-x-8 lg:col-span-7">
      {
        pains.map((p, i) => (
          <li class="border-t border-line py-6 sm:py-7" data-reveal style={`--reveal-i:${i}`}>
            <span class="font-display text-[1rem] font-semibold tabular-nums text-accent-ink">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2 text-h3 font-semibold">{p.title}</h3>
            <p class="mt-2 text-ink-2">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

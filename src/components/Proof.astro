---
const figures = [
  { values: [10000], suffix: '+', context: 'students learning on Study Buddy' },
  { values: [98], suffix: '%', context: 'pass rate among Study Buddy students' },
  { values: [94], suffix: '%', context: 'of students reported improvement with the AI study plan' },
  { values: [68, 95], suffix: '', context: "one student's JEE Main percentile, before and after" },
];
const fmt = (n: number) => n.toLocaleString('en-IN');

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  institution: string;
  city: string;
}
const testimonials: Testimonial[] = [];
---

<section id="proof" aria-labelledby="proof-title" class="border-b border-line">
  <div class="container-page py-12 lg:py-16">
    <h2 id="proof-title" class="flex items-center gap-2 font-body text-eyebrow font-semibold uppercase text-accent-ink">
      <span aria-hidden="true" class="h-0.5 w-6 bg-accent"></span>
      Results so far
    </h2>

    <dl class="mt-6 grid grid-cols-2 gap-y-8 lg:mt-8 lg:grid-cols-4" data-counters>
      {
        figures.map((f, i) => (
          <div
            class:list={[
              'flex flex-col-reverse justify-end gap-2 border-line-strong/40 pr-4',
              i % 2 === 1 && 'border-l pl-4',
              i > 0 && 'lg:border-l lg:pl-6',
            ]}
            data-reveal
            style={`--reveal-i:${i}`}
          >
            <dt class="max-w-[24ch] text-ink-2">{f.context}</dt>
            <dd class="font-display text-[clamp(2.25rem,1.9rem+1.6vw,3.25rem)] leading-none font-medium tracking-[-0.02em] text-ink tabular-nums">
              <span class="inline-flex items-baseline gap-2">
                {f.values.map((n, j) => (
                  <>
                    {j > 0 && (
                      <>
                        <span class="text-[0.6em] text-accent" aria-hidden="true">→</span>
                        <span class="sr-only">to</span>
                      </>
                    )}
                    <span class:list={['relative inline-block', f.values.length > 1 && j === 0 && 'text-ink-2']}>
                      <span class="invisible">{fmt(n)}</span>
                      <span class="absolute inset-0 text-right" aria-hidden="true" data-count={n}>
                        {fmt(n)}
                      </span>
                      <span class="sr-only">{fmt(n)}</span>
                    </span>
                  </>
                ))}
              </span>
              {f.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-8 text-small text-ink-2">From Study Buddy platform data. Ask us for the breakdown in your demo.</p>

    {
      testimonials.length > 0 && (
        <ul class="mt-12 grid gap-5 lg:grid-cols-3">
          {testimonials.map((t) => (
            <li class="rounded-md border border-line bg-surface p-6 sm:p-8">
              <blockquote>
                <p class="font-display text-h3 italic">
                  <span aria-hidden="true" class="text-accent">“</span>
                  {t.quote}
                </p>
              </blockquote>
              <p class="mt-5 border-t border-line pt-4 text-small">
                <strong class="font-semibold text-ink">{t.name}</strong>
                <span class="text-ink-2">
                  , {t.role}, {t.institution}, {t.city}
                </span>
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

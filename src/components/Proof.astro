---
import Eyebrow from './Eyebrow.astro';

const figures = [
  { values: [10000], suffix: '+', context: 'students learning on Study Buddy' },
  { values: [98], suffix: '%', context: 'pass rate among Study Buddy students' },
  { values: [94], suffix: '%', context: 'of students reported improvement with the AI study plan' },
  { values: [68, 95], suffix: '', context: "one student's JEE Main percentile after focused practice" },
];
const fmt = (n: number) => n.toLocaleString('en-IN');

interface Testimonial {
  quote: string;
  name: string;
  role: string;
  institution: string;
  city: string;
}
const testimonials: Testimonial[] = [];
---

<section id="proof" aria-labelledby="proof-title" class="section-y bg-paper-2">
  <div class="container-page grid-page gap-y-10">
    <div class="col-span-4 sm:col-span-8 lg:col-span-4" data-reveal>
      <Eyebrow>Results so far</Eyebrow>
      <h2 id="proof-title" class="mt-4 text-h2 lg:mt-5">What the numbers and school leaders say.</h2>
    </div>

    <div class="col-span-4 sm:col-span-8 lg:col-span-7 lg:col-start-6">
      <dl class="grid border-t border-line-strong/40 sm:grid-cols-2" data-counters>
        {
          figures.map((f, i) => (
            <div
              class:list={[
                'flex flex-col-reverse gap-2 border-b border-line-strong/40 py-7 sm:py-9',
                i % 2 === 0 && 'sm:border-r sm:pr-8',
                i % 2 === 1 && 'sm:pl-8',
              ]}
              data-reveal
              style={`--reveal-i:${i % 2}`}
            >
              <dt class="max-w-[28ch] text-ink-2">{f.context}</dt>
              <dd class="font-display text-[clamp(2.75rem,2.2rem+2.4vw,4rem)] leading-none font-medium tracking-[-0.02em] text-ink tabular-nums">
                <span class="inline-flex items-baseline gap-3">
                  {f.values.map((n, j) => (
                    <>
                      {j > 0 && (
                        <>
                          <span class="text-[0.6em] text-accent" aria-hidden="true">→</span>
                          <span class="sr-only">to</span>
                        </>
                      )}
                      <span class:list={['relative inline-block', f.values.length > 1 && j === 0 && 'text-ink-2']}>
                        <span class="invisible">{fmt(n)}</span>
                        <span class="absolute inset-0 text-right" aria-hidden="true" data-count={n}>
                          {fmt(n)}
                        </span>
                        <span class="sr-only">{fmt(n)}</span>
                      </span>
                    </>
                  ))}
                </span>
                {f.suffix}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-5 text-small text-ink-2">Based on Study Buddy platform data.</p>

      {
        testimonials.length > 0 && (
          <ul class="mt-12 grid gap-5">
            {testimonials.map((t) => (
              <li class="rounded-md border border-line bg-surface p-6 sm:p-8">
                <blockquote>
                  <p class="font-display text-h3 italic">
                    <span aria-hidden="true" class="text-accent">“</span>
                    {t.quote}
                  </p>
                </blockquote>
                <p class="mt-5 border-t border-line pt-4 text-small">
                  <strong class="font-semibold text-ink">{t.name}</strong>
                  <span class="text-ink-2">
                    , {t.role}, {t.institution}, {t.city}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>

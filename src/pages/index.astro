---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CoverageStrip from '../components/CoverageStrip.astro';
import Problem from '../components/Problem.astro';
import Roles from '../components/Roles.astro';
import Journey from '../components/Journey.astro';
import Spotlights from '../components/Spotlights.astro';
import Management from '../components/Management.astro';
import Foundation from '../components/Foundation.astro';
import Gains from '../components/Gains.astro';
import Proof from '../components/Proof.astro';
import Pilot from '../components/Pilot.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import heroPhoto from '../assets/photos/hero-students-classroom.jpg';
import { faqs } from '../data/faq';

// Preload the LCP image at the same widths/format Hero's <Picture> generates,
// so the browser starts fetching it from the HTML <head> rather than waiting
// to discover the <img> in the body.
const heroPreloadSrcset = (
  await Promise.all(
    [480, 768, 1200].map(async (width) => {
      const img = await getImage({ src: heroPhoto, format: 'avif', width });
      return `${img.src} ${width}w`;
    }),
  )
).join(', ');
const heroPreloadSizes = '(min-width: 1024px) 588px, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2rem)';
const heroPreloadFallback = (await getImage({ src: heroPhoto, format: 'avif', width: 480 })).src;
---

<Base
  title="Study Buddy — AI learning platform for schools and academies"
  description="One AI platform for students, teachers, parents and management. Handwritten answer-sheet evaluation, fresh practice for CBSE, JEE and NEET."
  ogTitle="Turn everyday learning into visible progress — Study Buddy"
  ogDescription="AI answer-sheet evaluation, a question bank that doesn't repeat, and one dashboard for your whole institute. Start with a free demo."
  heroPreloadSrcset={heroPreloadSrcset}
  heroPreloadSizes={heroPreloadSizes}
  heroPreloadFallback={heroPreloadFallback}
  faqs={faqs}
>
  <Header />
  <main id="main">
    <Hero />
    <CoverageStrip />
    <Problem />
    <Roles />
    <Journey />
    <Spotlights />
    <Management />
    <Foundation />
    <Gains />
    <Proof />
    <Pilot />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <StickyCta />
</Base>
